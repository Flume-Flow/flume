{
  "name": "@flume/cli",
  "version": "0.0.1",
  "repository": "git@github.com:Flume-Flow/flume.git",
  "author": "Oleksandr Samsonov",
  "license": "MIT",
  "type": "module",
  "bin": {
    "flume": "dist/main.js"
  },
  "scripts": {
    "preinstall": "node ../scripts/check-node.js",
    "clean": "rm -rf dist",
    "build": "pnpm run clean && tsup",
    "dev": "tsup --watch",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "prepublishOnly": "cp ../LICENSE ./LICENSE",
    "postpublish": "rm ./LICENSE"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "ink": "^7.0.6",
    "ink-select-input": "^6.0.0",
    "ink-text-input": "^6.0.0",
    "omelette": "^0.4.14",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.0"
  }
}
