{
  "name": "flume",
  "private": true,
  "license": "MIT",
  "packageManager": "yarn@4.16.0",
  "workspaces": [
    "scripts",
    "cli"
  ],
  "scripts": {
    "preinstall": "node scripts/check-node.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "build": "yarn workspace @flume/cli build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "coverage:update": "node scripts/update-coverage.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.2",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/ui": "^4.1.8",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8"
  }
}
