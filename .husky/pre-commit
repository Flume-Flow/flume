if git diff --cached --name-only | grep -q 'package\.json'; then
  if ! pnpm install --frozen-lockfile --lockfile-only >/dev/null 2>&1; then
    echo "❌ package.json changed but pnpm-lock.yaml is out of sync."
    echo "   Run: pnpm install"
    echo "   Then re-stage pnpm-lock.yaml and commit again."
    exit 1
  fi
fi

STAGED=$(node scripts/changed-files.js --staged)
if [ -n "$STAGED" ]; then
  echo "$STAGED" | xargs ./node_modules/.bin/biome check
fi
