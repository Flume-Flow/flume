BASE=$(git merge-base HEAD origin/main 2>/dev/null || echo "")

if [ -n "$BASE" ]; then
    CHANGED=$(node scripts/changed-files.js --base "$BASE")
    if [ -n "$CHANGED" ]; then
        echo "$CHANGED" | xargs ./node_modules/.bin/eslint
    fi
fi

pnpm build

if command -v gh >/dev/null 2>&1; then
    IS_DRAFT=$(gh pr view --json isDraft -q '.isDraft' 2>/dev/null) || true
    if [ "$IS_DRAFT" = "false" ]; then
        pnpm test:coverage
    fi
else
    if ! pnpm test:coverage; then
        echo ""
        echo "⚠️  Coverage is below thresholds. Install gh CLI to enforce this on every push."
        echo "   Run: node scripts/setup-gh.js"
        echo ""
    fi
fi
